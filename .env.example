# Copy to .env (ignored by git) and replace every value.

# SQL Server rules: at least 8 characters with upper case, lower case and a digit. Avoid ";" in the password.
SA_PASSWORD=

# Random string of at least 32 characters, for example: openssl rand -base64 48
JWT_KEY=

# First administrator, created at startup
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# https://developer.tech.yandex.ru — JavaScript API and HTTP Geocoder
YANDEX_MAPS_API_KEY=
# https://openweathermap.org/api
OPENWEATHER_API_KEY=
