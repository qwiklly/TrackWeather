@page
@model AdminMapModel
@{
	ViewData["Title"] = L["UtilityMap.Title"].Value;
}
<div class="page-header">
	<div>
		<h1>@L["UtilityMap.Title"]</h1>
		<p class="page-header__hint">@L["UtilityMap.Hint"]</p>
	</div>
</div>
<partial name="_MapHost" model="Model.ApiKey" />

@section Scripts {
	<partial name="_MapScripts" model="Model.ApiKey" />
	<script src="~/js/adminMap.js" asp-append-version="true"></script>
}
