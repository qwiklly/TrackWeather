@page
@model TransportRequestPageModel
@using TrackWeatherWeb.Models
@{
	ViewData["Title"] = L["Transport.Title"].Value;
	(TransportStatus? Value, string Label)[] filters =
	[
		(null, L["Transport.FilterAll"]),
		(TransportStatus.New, L["Status.New"]),
		(TransportStatus.InProgress, L["Status.InProgress"]),
		(TransportStatus.Completed, L["Status.Completed"]),
		(TransportStatus.Cancelled, L["Status.Cancelled"]),
	];
}
<div class="page-header">
	<h1>@L["Transport.Title"]</h1>
	<a class="btn btn-primary btn-sm" asp-page="/AdminMap"><i class="bi bi-truck" aria-hidden="true"></i> @L["Nav.UtilityMap"]</a>
</div>

<ul class="nav nav-pills status-filter mb-3">
	@foreach (var filter in filters)
	{
		var isActive = Model.Status == filter.Value;
		<li class="nav-item">
			<a class="nav-link @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)" asp-page="/TransportRequestPage" asp-route-status="@filter.Value">@filter.Label</a>
		</li>
	}
</ul>

<div data-live-table="@Url.Page("/TransportRequestPage", "Table", new { status = Model.Status })">
	<partial name="_TransportTable" model="Model" />
</div>
