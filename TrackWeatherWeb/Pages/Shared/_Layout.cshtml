<!DOCTYPE html>
<html lang="@SupportedLanguages.Current">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - @L["App.Name"]</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"
		  integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
	<header class="app-header">
		<button class="navbar-toggler app-header__toggle d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar"
				aria-controls="sidebar" aria-expanded="false" aria-label="@L["Nav.Toggle"]">
			<i class="bi bi-list" aria-hidden="true"></i>
		</button>
		<a class="app-header__brand" asp-page="/Index">
			<i class="bi bi-cloud-sun-fill" aria-hidden="true"></i> @L["App.Name"]
		</a>
		<div class="app-header__actions">
			<partial name="_LanguageSwitcher" />
			@if (User.Identity?.IsAuthenticated == true)
			{
				<div class="dropdown">
					<button class="btn btn-sm app-header__user dropdown-toggle" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
						<i class="bi bi-person-circle" aria-hidden="true"></i>
						<span class="d-none d-sm-inline">@User.Identity.Name</span>
					</button>
					<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
						<li>
							<form method="post" asp-page="/LogoutPage">
								<button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> @L["Nav.Logout"]</button>
							</form>
						</li>
					</ul>
				</div>
			}
			else
			{
				<a class="btn btn-sm btn-light" asp-page="/Login">@L["Nav.Login"]</a>
			}
		</div>
	</header>

	<div class="app-body">
		<nav id="sidebar" class="app-sidebar collapse d-md-block" aria-label="@L["Nav.Main"]">
			<ul class="nav flex-column">
				@NavLink("/Index", "bi-house-door-fill", L["Nav.Home"])
				@if (User.Identity?.IsAuthenticated == true)
				{
					@NavLink("/UsersMap", "bi-geo-alt-fill", L["Nav.WeatherMap"])
					@NavLink("/MyRequests", "bi-card-checklist", L["Nav.MyRequests"])
				}
				else
				{
					@NavLink("/Login", "bi-box-arrow-in-right", L["Nav.Login"])
					@NavLink("/Registration", "bi-person-plus-fill", L["Nav.Register"])
				}
				@if (User.IsInRole(Roles.Admin))
				{
					<li class="app-sidebar__heading">@L["Nav.Administration"]</li>
					@NavLink("/AdminMap", "bi-truck", L["Nav.UtilityMap"])
					@NavLink("/TransportRequestPage", "bi-list-check", L["Nav.TransportRequests"])
					@NavLink("/UsersPage", "bi-people-fill", L["Nav.Users"])
					@NavLink("/AddUser", "bi-person-plus-fill", L["Nav.AddUser"])
				}
			</ul>
		</nav>

		<div class="app-content">
			<main class="app-main">
				<partial name="_StatusMessages" />
				@RenderBody()
			</main>
			<footer class="app-footer">
				&copy; @DateTime.UtcNow.Year @L["App.Name"] &middot; <a asp-page="/Privacy">@L["Nav.Privacy"]</a>
			</footer>
		</div>
	</div>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@if (User.Identity?.IsAuthenticated == true)
	{
		<partial name="_LiveUpdates" />
	}
	@RenderSection("Scripts", required: false)
</body>
</html>

@functions {
	private Microsoft.AspNetCore.Html.IHtmlContent NavLink(string page, string icon, LocalizedString title)
	{
		var active = ViewContext.RouteData.Values["page"]?.ToString() == page;
		var href = Url.Page(page);
		return new Microsoft.AspNetCore.Html.HtmlContentBuilder()
			.AppendHtml("<li class=\"nav-item\"><a class=\"nav-link")
			.AppendHtml(active ? " active\" aria-current=\"page\"" : "\"")
			.AppendHtml(" href=\"").Append(href ?? "#").AppendHtml("\"><i class=\"bi ")
			.Append(icon).AppendHtml("\" aria-hidden=\"true\"></i> ")
			.Append(title.Value).AppendHtml("</a></li>");
	}
}
