@page
@model UsersMapModel
@{
	ViewData["Title"] = L["WeatherMap.Title"].Value;
}
<div class="page-header">
	<div>
		<h1>@L["WeatherMap.Title"]</h1>
		<p class="page-header__hint">@L["WeatherMap.Hint"]</p>
	</div>
</div>
<partial name="_MapHost" model="Model.ApiKey" />

@section Scripts {
	<partial name="_MapScripts" model="Model.ApiKey" />
	<script src="~/js/usersMap.js" asp-append-version="true"></script>
}
