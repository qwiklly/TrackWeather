@page "/Error/{code:int?}"
@model ErrorModel
@{
	ViewData["Title"] = L["Error.Title"].Value;
	var message = Model.Code switch
	{
		StatusCodes.Status403Forbidden => L["Error.Forbidden"],
		StatusCodes.Status404NotFound => L["Error.NotFound"],
		StatusCodes.Status429TooManyRequests => L["Error.TooManyRequests"],
		_ => L["Error.Server"],
	};
}
<div class="error-card">
	<div class="error-card__code">@(Model.Code ?? 500)</div>
	<h1>@L["Error.Title"]</h1>
	<p>@message</p>
	<a class="btn btn-primary" asp-page="/Index">@L["Error.BackHome"]</a>
	@if (Model.ShowRequestId)
	{
		<p class="error-card__trace"><strong>@L["Error.RequestId"]:</strong> <code>@Model.RequestId</code></p>
	}
</div>
