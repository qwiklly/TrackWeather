@page
@model AddUserModel
@{
	ViewData["Title"] = L["AddUser.Title"].Value;
}
<div class="auth-card">
	<h1 class="auth-card__title">@L["AddUser.Title"]</h1>

	<form method="post" data-loading-form>
		<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

		<div class="mb-3">
			<label asp-for="Register.Role" class="form-label"></label>
			<select asp-for="Register.Role" class="form-select">
				<option value="@Roles.User">@L["Role.User"]</option>
				<option value="@Roles.Admin">@L["Role.Admin"]</option>
			</select>
			<span asp-validation-for="Register.Role" class="text-danger small"></span>
		</div>

		<partial name="_UserFields" model="Model.Register" view-data='new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "Register" } }' />
		<button type="submit" class="btn btn-primary w-100">@L["AddUser.Submit"]</button>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
