@page
@model RegistrationModel
@{
	ViewData["Title"] = L["Register.Title"].Value;
}
<div class="auth-card">
	<h1 class="auth-card__title">@L["Register.Title"]</h1>

	<form method="post" data-loading-form>
		<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
		<partial name="_UserFields" model="Model.Register" view-data='new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "Register" } }' />
		<button type="submit" class="btn btn-primary w-100">@L["Register.Submit"]</button>
	</form>

	<p class="auth-card__footer">@L["Register.HasAccount"] <a asp-page="/Login">@L["Nav.Login"]</a></p>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
