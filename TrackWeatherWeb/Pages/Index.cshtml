@page
@model IndexModel
@{
	ViewData["Title"] = L["Home.Title"].Value;
	var isSignedIn = User.Identity?.IsAuthenticated == true;
}
<section class="hero">
	<h1 class="hero__title">
		@if (isSignedIn)
		{
			@L["Home.WelcomeUser", User.Identity!.Name!]
		}
		else
		{
			@L["Home.Welcome"]
		}
	</h1>
	<p class="hero__lead">@L["Home.Lead"]</p>
	@if (isSignedIn)
	{
		<a class="btn btn-light" asp-page="/UsersMap"><i class="bi bi-signpost-split" aria-hidden="true"></i> @L["Home.OpenMap"]</a>
	}
	else
	{
		<a class="btn btn-light" asp-page="/Registration">@L["Nav.Register"]</a>
		<a class="btn btn-outline-light" asp-page="/Login">@L["Nav.Login"]</a>
	}
</section>

<h2 class="home-section-title">@L["Home.ForTravelers"]</h2>
<section class="row g-3 mb-4">
	<div class="col-md-4">
		<article class="feature-card">
			<i class="bi bi-signpost-split" aria-hidden="true"></i>
			<h3>@L["Home.Feature.Route.Title"]</h3>
			<p>@L["Home.Feature.Route.Text"]</p>
		</article>
	</div>
	<div class="col-md-4">
		<article class="feature-card">
			<i class="bi bi-clock-history" aria-hidden="true"></i>
			<h3>@L["Home.Feature.Departure.Title"]</h3>
			<p>@L["Home.Feature.Departure.Text"]</p>
		</article>
	</div>
	<div class="col-md-4">
		<article class="feature-card">
			<i class="bi bi-cloud-sun" aria-hidden="true"></i>
			<h3>@L["Home.Feature.Weather.Title"]</h3>
			<p>@L["Home.Feature.Weather.Text"]</p>
		</article>
	</div>
</section>

<h2 class="home-section-title">@L["Home.ForServices"]</h2>
<section class="row g-3">
	<div class="col-md-6">
		<article class="feature-card">
			<i class="bi bi-life-preserver" aria-hidden="true"></i>
			<h3>@L["Home.Feature.Help.Title"]</h3>
			<p>@L["Home.Feature.Help.Text"]</p>
		</article>
	</div>
	<div class="col-md-6">
		<article class="feature-card">
			<i class="bi bi-truck" aria-hidden="true"></i>
			<h3>@L["Home.Feature.Dispatch.Title"]</h3>
			<p>@L["Home.Feature.Dispatch.Text"]</p>
		</article>
	</div>
</section>
