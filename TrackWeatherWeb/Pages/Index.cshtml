@page
@model IndexModel
@{
	ViewData["Title"] = L["Home.Title"].Value;
	var isSignedIn = User.Identity?.IsAuthenticated == true;
}
<section class="hero">
	<h1 class="hero__title">
		@if (isSignedIn)
		{
			@L["Home.WelcomeUser", User.Identity!.Name!]
		}
		else
		{
			@L["Home.Welcome"]
		}
	</h1>
	<p class="hero__lead">@L["Home.Lead"]</p>
	@if (isSignedIn)
	{
		<a class="btn btn-light" asp-page="/UsersMap"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> @L["Home.OpenMap"]</a>
	}
	else
	{
		<a class="btn btn-light" asp-page="/Registration">@L["Nav.Register"]</a>
		<a class="btn btn-outline-light" asp-page="/Login">@L["Nav.Login"]</a>
	}
</section>

<section class="row g-3">
	<div class="col-md-6 col-xl-3">
		<article class="feature-card">
			<i class="bi bi-cloud-sun" aria-hidden="true"></i>
			<h2>@L["Home.Feature.Weather.Title"]</h2>
			<p>@L["Home.Feature.Weather.Text"]</p>
		</article>
	</div>
	<div class="col-md-6 col-xl-3">
		<article class="feature-card">
			<i class="bi bi-signpost-split" aria-hidden="true"></i>
			<h2>@L["Home.Feature.Route.Title"]</h2>
			<p>@L["Home.Feature.Route.Text"]</p>
		</article>
	</div>
	<div class="col-md-6 col-xl-3">
		<article class="feature-card">
			<i class="bi bi-truck" aria-hidden="true"></i>
			<h2>@L["Home.Feature.Transport.Title"]</h2>
			<p>@L["Home.Feature.Transport.Text"]</p>
		</article>
	</div>
	<div class="col-md-6 col-xl-3">
		<article class="feature-card">
			<i class="bi bi-shield-lock" aria-hidden="true"></i>
			<h2>@L["Home.Feature.Admin.Title"]</h2>
			<p>@L["Home.Feature.Admin.Text"]</p>
		</article>
	</div>
</section>
