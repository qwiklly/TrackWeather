{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "TrackWeather",
    "Audience": "TrackWeather.Api",
    "ExpiryMinutes": 60
  },
  "YandexMaps": {
    "ApiKey": ""
  },
  "OpenWeatherApi": {
    "BaseUrl": "https://api.openweathermap.org",
    "ApiKey": ""
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 20,
    "UserActionsPerMinute": 20
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  }
}
